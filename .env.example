# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Neon pooled connection used by the deployed Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection used only by Prisma CLI migrations and schema commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Disposable Neon branch/database used by destructive integration-test resets.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@TEST-HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local NitroStudio demo identity only. Production deployments must use
# authenticated subjects and organization/tenant claims instead.
CAREFLOW_DEMO_ACTOR_ID=user-01
CAREFLOW_DEMO_ORGANIZATION_ID=org-careflow-001

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
