# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# CareFlow local SQLite database
DATABASE_URL="file:./data/careflow.db"

# Local NitroStudio demo identity only. Production deployments must use
# authenticated subjects and organization/tenant claims instead.
CAREFLOW_DEMO_ACTOR_ID=user-01
CAREFLOW_DEMO_ORGANIZATION_ID=org-careflow-001

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
